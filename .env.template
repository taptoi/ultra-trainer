# Copy this file to `.env` and replace the placeholders with real values.
# Used for authentication with the Strava API.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_ACCESS_TOKEN=

# OpenAI API configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Default location used for workout recommendations if not set in athlete profile.
# Examples: "Copenhagen, Denmark", "New York, USA"
USER_LOCATION=

# Example database connection string.
DATABASE_URL=sqlite:///ultra-trainer.db

CLAUDE_API_KEY=
CLAUDE_MODEL=